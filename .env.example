# ──────────────────────────────────────────────
# Fast Burguer API - exemplo de configuracao local
# Copie para .env e ajuste os valores:  cp .env.example .env
# O arquivo .env NUNCA deve ser commitado.
# ──────────────────────────────────────────────

# Porta HTTP da API
PORT=3000

# Base usada para montar o atributo virtual `url` das imagens
# (produtos e categorias). Use o host publico em producao.
APP_URL=http://localhost:3000

# Chave de assinatura do JWT. Gere uma string longa e aleatoria:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-este-segredo

# Host compartilhado pelo PostgreSQL e pelo MongoDB
DB_HOST=localhost

# PostgreSQL (catalogo: users, products, categories)
DB_PORT_POSTGRES=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fastburguer

# MongoDB (pedidos). O nome do database `fastburguer` esta fixo
# em src/database/index.js
DB_PORT_MONGODB=27017
